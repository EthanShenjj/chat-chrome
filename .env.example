# Copy into your deployment environment; do not commit real secrets.
AE_CHAT_ENCRYPTION_KEY=
AE_CHAT_SERVER_DATA_DIR=.server-data
# Public HTTPS origin when running behind a reverse proxy (optional locally).
AE_CHAT_PUBLIC_URL=
# Exact origins approved for AE, model providers and HTTP MCP. No wildcard.
AE_CHAT_ALLOWED_ORIGINS=https://api.openai.com,https://api.deepseek.com,https://api.moonshot.cn,https://api.moonshot.ai,https://your-ae.example.com
# chrome://extensions IDs. Empty means web workspace only, no extension CORS access.
AE_CHAT_EXTENSION_IDS=
# Administrator-controlled aliases only. User-provided arbitrary commands are rejected.
AE_CHAT_STDIO_COMMANDS={}
# Vercel gateway + persistent execution sandbox (unused for standalone/Docker).
AE_CHAT_GATEWAY_SECRET=
AE_CHAT_SANDBOX_NAME=chat-chrome-production
