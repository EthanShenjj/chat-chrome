{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "allowImportingTsExtensions": true, "noEmit": true,
    "types": ["chrome", "node"]
  },
  "include": ["apps", "packages", "tests"],
  "exclude": ["node_modules", "dist", "release", "apps/server/.next", "apps/gateway/.next"]
}
