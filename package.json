{
  "name": "ae-chat-agent",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "build": "npm run build:extension && npm run build:server",
    "build:extension": "node scripts/build.mjs",
    "build:server": "node scripts/run-next.mjs build && node scripts/prepare-server.mjs",
    "build:gateway": "node scripts/run-gateway.mjs build",
    "server:provision": "node scripts/provision-sandbox.mjs",
    "dev": "node scripts/run-next.mjs dev",
    "dev:extension": "node scripts/build.mjs --watch",
    "start": "node scripts/start-server.mjs",
    "server:user": "node scripts/server-user.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node tests/browser/smoke.mjs",
    "test:server": "node tests/integration/server-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "preview": "node scripts/preview.mjs",
    "legacy:host:build": "node scripts/build.mjs --legacy-native"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@openai/agents": "0.21.0",
    "@vercel/sandbox": "3.9.1",
    "ajv": "^8.17.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "next": "^16.4.4",
    "openai": "^7.47.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
